# Exemplo. Nunca coloque senhas reais neste arquivo.

APP_ENV=development
APP_URL=http://localhost:5173
PORT=3001
VITE_DEV_USER_ID=usr_000001

# Local SQLite development database.
DATABASE_URL="file:./dev.db"

# Supabase Postgres development/homologation database.
# Never commit real credentials. Put the real value only in your local .env.
# Example format:
# SUPABASE_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional isolated PostgreSQL database for automated persistence tests.
# If omitted, tests use SUPABASE_DATABASE_URL and isolate data in a temporary schema.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

AUTH_SECRET=dev-only-change-me
AI_PROVIDER=disabled
AI_API_KEY=
STORAGE_URL=
